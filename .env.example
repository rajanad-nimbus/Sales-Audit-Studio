# Database Configuration
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=dbname
POSTGRES_PORT=5434

# Backend Configuration
BACKEND_PORT=8001
DATABASE_URL=postgresql+asyncpg://user:password@postgres:5432/dbname
SQL_ECHO=False
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3001,http://127.0.0.1:3001,http://localhost:3000,http://127.0.0.1:3000

# Frontend Configuration
FRONTEND_PORT=3001
NEXT_PUBLIC_API_URL=http://localhost:8001
NEXT_PUBLIC_ONTOLOGY_STUDIO_URL=http://localhost:3050


# Authentication is delegated to Ontology Studio. Map Ontology roles to Nimbus roles as needed.
NIMBUS_ONTOLOGY_AUTH_URL=http://host.docker.internal:8000/api/v1/auth/me
NIMBUS_ONTOLOGY_ROLE_MAP=admin:admin,owner:admin,finance:finance,it:it,analyst:analyst,auditor:auditor,store_manager:store_manager
# Where Ontology Studio puts a user's assigned stores in the identity returned by the auth endpoint (a dotted path; a list or comma-separated codes).
# A store manager sees only these stores. With none assigned they see nothing.
NIMBUS_ONTOLOGY_STORE_CLAIM=stores

# LLM Investigation agent. It is on by default but needs a key: without ANTHROPIC_API_KEY every
# investigation falls back to deterministic checks. Set NIMBUS_AGENT_INVESTIGATOR=0 to turn it off.
# Amounts, policy and approval authority always stay deterministic; the model only investigates and drafts.
ANTHROPIC_API_KEY=
# Development phase: Haiku for every agent. Switch to a larger model (claude-sonnet-5-5, claude-opus-5-5) for production.
NIMBUS_LLM_MODEL=claude-haiku-4-5-20251001
NIMBUS_AGENT_INVESTIGATOR=1
NIMBUS_AUTO_INVESTIGATE=1
# Cost controls: the LLM agent investigates the top-N cases by exposure per batch (the rest use deterministic
# checks and can be run on demand), and each investigation stops at this spend.
NIMBUS_AGENT_BATCH_LIMIT=25
NIMBUS_AGENT_MAX_COST_USD=0.50

# Ontology Studio read-only integration. Issue an ons_ agent key in Access &
# Governance. For two Docker Compose projects on Docker Desktop, use:
# http://host.docker.internal:8000/api/integration/v1
NIMBUS_ONTOLOGY_API_URL=http://host.docker.internal:8000/api/integration/v1
NIMBUS_ONTOLOGY_API_KEY=

# Export sink signing secret (change outside local demos).
NIMBUS_SINK_SECRET=demo-secret

# Shopify integration. Leave SHOPIFY_STORE_URL empty to disable it (the daily batch then skips Shopify).
SHOPIFY_STORE_URL=
# Auth: Admin API access token (custom app, preferred), or legacy private-app key + password.
SHOPIFY_ACCESS_TOKEN=
SHOPIFY_API_KEY=
SHOPIFY_API_PASSWORD=
SHOPIFY_API_VERSION=2024-01
# store_id stamped on records from the daily batch and webhooks.
SHOPIFY_STORE_ID=SHOPIFY-MAIN
# Signing secret for webhooks (Shopify admin > Notifications > Webhooks).
SHOPIFY_WEBHOOK_SECRET=
# Orders per API page (max 250) and default sync window in days.
SHOPIFY_FETCH_LIMIT=250
SHOPIFY_SYNC_LOOKBACK_DAYS=3

# Claude Code Authentication Token for Development
CLAUDE_CODE_OAUTH_TOKEN=